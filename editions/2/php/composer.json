{
    "name": "rentman/functional-matchmaking-kata-php",
    "description": "Functional Programming videogame matchmaking kata (PHP variant)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "files": [
            "matchmaker/Player.php",
            "matchmaker/electHosts.php",
            "matchmaker/balancingGames.php"
        ]
    },
    "scripts": {
        "start": "php matchmaker/main.php",
        "test": "phpunit --testdox"
    },
    "config": {
        "sort-packages": true
    }
}
